# Root .env.example — superset reference. Each service consumes services/<name>/.env. Do NOT load this file directly.

# ─── Shared ──────────────────────────────────────────────────────────────────
NODE_ENV=development
CURRENCY_CODE=CRD
CURRENCY_BASE=10
CURRENCY_EXPONENT=2

# ─── Games service ───────────────────────────────────────────────────────────
# Connections
# DATABASE_URL=postgresql://admin:admin@postgres:5432/games
# RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672
PORT=4001

# Round loop
BETTING_WINDOW_MS=5000
COOLDOWN_MS=2000
SERVER_TICK_HZ=30
GROWTH_RATE=0.06
INSTANT_CRASH_BUCKET=101

# Bet bounds (OD8 — pending user confirmation pre-Phase 4)
BET_MIN_CENTS=100
BET_MAX_CENTS=100000

# Provably-fair
HASH_CHAIN_LENGTH=1000000

# Saga
SAGA_TIMEOUT_MS=5000
# Phase 5: how often SagaTimeoutSweeper polls for expired bet_saga_state rows (games service)
SAGA_SWEEP_INTERVAL_MS=1000

# Auto-cashout (OD14 — pending user confirmation pre-Phase 9)
AUTO_CASHOUT_MAX_X=100

# Leaderboard
LEADERBOARD_WINDOW_HOURS=24
LEADERBOARD_TOP_N=10

# ─── Wallets service ─────────────────────────────────────────────────────────
# Connections
# DATABASE_URL=postgresql://admin:admin@postgres:5432/wallets
# PORT=4002

# Wallet bootstrap
# 1000.00 CRD — REQ-WALL-03 + REQ-DOM-05
INITIAL_BALANCE_CENTS=100000

# ─── Shared messaging (both services) ────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=1000
RMQ_DELIVERY_LIMIT_MAIN=5
RMQ_DELIVERY_LIMIT_DLQ=3

# ─── Keycloak JWT validation (REQ-AUTH-04, every backend service) ────────────
# ISSUER is the value Keycloak stamps into the iss claim (browser-facing host).
# JWKS_URI is the in-network fetch URL (Docker service name).
# AUDIENCE: with no protocol mapper on crash-game-client (public PKCE), Keycloak emits aud=account by default.
KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/crash-game/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=crash-game-client
