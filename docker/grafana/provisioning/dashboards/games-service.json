{
  "id": null,
  "uid": "games-service-overview",
  "title": "Games Service Overview",
  "tags": ["crash-game", "games", "nestjs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate (req/s) by route",
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "sum by (route) (rate(http_server_requests_total{job=\"games-service\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request duration p95/p99 (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{job=\"games-service\"}[1m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{job=\"games-service\"}[1m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AMQP publish rate (msg/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "mps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "sum by (exchange) (rate(messaging_rabbitmq_publish_total{job=\"games-service\"}[1m]))",
          "legendFormat": "publish {{exchange}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "sum by (queue) (rate(messaging_rabbitmq_consume_total{job=\"games-service\"}[1m]))",
          "legendFormat": "consume {{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active WS connections",
      "datasource": { "type": "prometheus", "uid": "prometheus-main" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus-main" },
          "expr": "active_ws_connections{job=\"games-service\"}",
          "legendFormat": "connections"
        }
      ]
    }
  ]
}
