# Frontend configuration — every value is parsed by src/lib/config.ts (zod).
# No business constant may be hardcoded elsewhere in the FE.

# Keycloak OIDC (public PKCE client). Issuer host MUST be localhost:8080 — realm redirectUris only allow :3000/:8080.
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/crash-game
VITE_KEYCLOAK_CLIENT_ID=crash-game-client

# Kong gateway. WS socket path is '/ws'; REST routes under the same origin.
VITE_WS_URL=http://localhost:8000
VITE_REST_BASE=http://localhost:8000

# Curve math. GROWTH_RATE must match the games service (multiplierAt throws if <= 0).
VITE_GROWTH_RATE=0.06

# EWMA clock-offset reconciliation alpha (0..1). Higher = snappier, lower = smoother. Tune during build.
VITE_EWMA_ALPHA=0.1

# History strip color bands (multiplier). <= red, <= yellow, > = emerald.
VITE_HISTORY_RED_MAX_X=1.5
VITE_HISTORY_YELLOW_MAX_X=2.0

# Bet bounds in cents (1.00 CRD min, 1000.00 CRD max).
VITE_BET_MIN_CENTS=100
VITE_BET_MAX_CENTS=100000

# Display currency code.
VITE_CURRENCY_CODE=CRD

# Live feed circular-buffer cap (newest-first, older entries evicted).
VITE_FEED_BUFFER_SIZE=50

# History strip size (last N settled rounds shown).
VITE_HISTORY_SIZE=20

# Replay speed selector options (D-03 / UI-SPEC). Must include 1.
VITE_REPLAY_SPEEDS=1,2,4
# Replay modal auto-plays on open at 1x.
VITE_REPLAY_AUTOSTART=true
# Verification drawer slide-in duration (MCP motion band 150-300ms).
VITE_DRAWER_SLIDE_MS=220
# Backend INSTANT_CRASH_BUCKET mirror; must match server env (Bustabit canon 1-in-N). Consumed by /verify/:roundId route.
VITE_INSTANT_CRASH_BUCKET=101

# Phase 9 — auto-bet target bounds (must be > 1.00x; max mirrors backend AUTO_CASHOUT_MAX_X).
VITE_AUTO_BET_MIN_TARGET=1.01
VITE_AUTO_BET_MAX_TARGET=100

# Phase 9 — leaderboard panel size + rolling window (mirror backend LEADERBOARD_TOP_N / LEADERBOARD_WINDOW_HOURS).
VITE_LEADERBOARD_SIZE=10
VITE_LEADERBOARD_WINDOW_HOURS=24
# Footer "updated Ns ago" tick interval; 0 disables the tick.
VITE_LEADERBOARD_RELATIVE_REFRESH_MS=5000
# Rank chip border transition on rank-up (sub-300ms MCP band; reduced-motion gated at the consumer).
VITE_RANK_UP_TRANSITION_MS=200
