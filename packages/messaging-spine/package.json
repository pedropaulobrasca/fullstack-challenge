{
  "name": "@crash/messaging-spine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/migrations/shared/*.sql": "./src/migrations/shared/*.sql"
  },
  "scripts": {
