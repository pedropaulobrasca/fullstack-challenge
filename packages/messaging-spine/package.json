    "@mikro-orm/nestjs": "^7.0.0",
    "@crash/shared-kernel": "workspace:*",
    "zod": "^3.23.0"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "nestjs-cls": "^6.2.0",
    "pg": "^8.21.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.21",
    "@testcontainers/postgresql": "latest",
    "@testcontainers/rabbitmq": "latest",
    "@types/amqplib": "^0.10.8",
    "@types/pg": "^8.20.0",
